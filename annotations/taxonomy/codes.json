{
  "_doc": "Canonical boxing-fault taxonomy — the single source of truth for evaluation. See README.md in this directory for why it exists and how the two engines are reconciled. Codes are identity, not display text: once shipped, a code's meaning must not drift. Add codes; never renumber or repurpose. Keep in sync with app/lib/analysis/error_codes.dart (Dart) and the rule `id`s in src/boxing_coach/analysis/rules/ (Python).",
  "version": 2,

  "severities": {
    "major": {"weight": 5},
    "moderate": {"weight": 3},
    "minor": {"weight": 1},
    "positive": {"weight": 0}
  },

  "categories": {
    "guard": "Hand/chin position and guard integrity",
    "rotation": "Shoulder/hip/heel rotation on punches",
    "balance": "Balance and weight distribution, esp. after punches",
    "footwork": "Stance geometry, foot placement, mobility",
    "lean": "Torso lean off the vertical",
    "body_position": "Head position, uprightness, centre of mass",
    "recovery": "Punch retraction / hand return",
    "head_movement": "Slipping and off-line head movement",
    "defence": "Defensive posture during/after exchanges",
    "tension": "Muscular tension / lack of relaxation"
  },

  "codes": {
